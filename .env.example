# Google Sheets конфигурация
# GOOGLE_SPREADSHEET_ID получите из URL документа: https://docs.google.com/spreadsheets/d/HERE
GOOGLE_SPREADSHEET_ID=

# Путь к файлу с учетными данными Google Service Account
# Скачайте JSON файл из https://console.cloud.google.com/
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Другие параметры
NODE_ENV=production
