        </div>
        
        <div class="absolute inset-0 bg-brand-primary/85 mix-blend-multiply -z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-brand-primary/90 to-transparent -z-10"></div>

        <div class="container mx-auto max-w-6xl fade-in-up">
