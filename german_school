    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Подключение Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Настройка конфигурации Tailwind -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            primary: '#1E293B',    // Slate 800 - Строгий темно-синий (основа)
                            secondary: '#334155',  // Slate 700 - Текст
                            accent: '#F59E0B',     // Amber 500 - Оранжевый акцент
                            accentHover: '#D97706',// Amber 600 - Ховер для кнопок
                            bg: '#F8FAFC',         // Slate 50 - Очень светлый фон
                            surface: '#FFFFFF',    // Белый
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Poppins', 'sans-serif'],
                    },
                    borderRadius: {
                        'lg': '0.5rem',
                        'xl': '0.75rem',     // Более строгие углы
                        '2xl': '1rem',
                    },
                    boxShadow: {
                        'subtle': '0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.01)',
                        'hover': '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)',
